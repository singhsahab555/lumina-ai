# Copy to .env (gitignored). Never commit real keys.

# Meta Model API: connected sender only (Muse Spark, SAM 3.1)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
# Site the sender packs work orders for (pinned in the bundle, checked by the receiver policy)
LUMINA_SITE=North Basin WTP

# Plant side (air-gapped network): verifier model on Ollama
OLLAMA_URL=http://localhost:11434
VERIFIER_MODEL=llama3.1:8b

# Baseten: connected sender, Muse Spark Open (used when MODEL_API_KEY is empty)
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open

# NVIDIA NIM (build.nvidia.com): connected-sender packer fallback when neither key above is set.
# Hosts Meta's open-weight Muse Glimmer 30B. Streamed: non-streamed calls 504 at the gateway.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/muse-glimmer-30b
